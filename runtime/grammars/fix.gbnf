# Grammar for structured fix output (llama.cpp / llama-server --grammar-file).
# Constrains generation to the exact JSON shape expected by verify.py / plans.py.
#
# RNP inspiration (PMC10637337): prediction-error-driven correction at the
# appropriate level of the hierarchy.

root   ::= object

object ::= "{" ws (summary "," ws diagnosis "," ws files) ws "}"
string ::= "\"" ([^\"\\] | "\\" (["\\/] | "n" | "t" | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
number ::= "-" ? ([0-9] | [1-9] [0-9]*)
ws     ::= [ \t\n]*

summary    ::= "\"" ws "summary" ws ":" ws string
diagnosis  ::= "\"" ws "diagnosis" ws ":" ws string
files      ::= "\"" ws "files" ws ":" ws file_array

file_array ::= "[" ws (file_obj ("," ws file_obj)*)? ws "]"
file_obj   ::= "{" ws (file_path "," ws ops) ws "}"
file_path  ::= "\"" ws "path" ws ":" ws string
ops        ::= "\"" ws "operations" ws ":" ws op_array

op_array  ::= "[" ws (operation ("," ws operation)*)? ws "]"
operation ::= "{" ws (op_type "," ws op_start "," ws op_end "," ws op_content) ws "}"
op_type   ::= "\"" ws "type" ws ":" ws ("replace" | "insert" | "delete") "\""
op_start  ::= "\"" ws "start_line" ws ":" ws number
op_end    ::= "\"" ws "end_line" ws ":" ws number
op_content::= "\"" ws "content" ws ":" ws string