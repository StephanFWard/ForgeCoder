# Grammar for structured patch output (llama.cpp / llama-server --grammar-file).
# Constrains generation to the exact JSON shape forge_server expects.

root   ::= object
object ::= "{" ws (summary "," ws files) ws "}"
value  ::= object | array | string | number | "true" | "false" | "null"
string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
number ::= "-"? ([0-9] | [1-9] [0-9]*)
ws     ::= [ \t\n]*

summary ::= "\"" ws "summary" ws ":" ws string
files   ::= "\"" ws "files" ws ":" ws array

array     ::= "[" ws (patch ("," ws patch)*)? ws "]"
patch     ::= "{" ws (path "," ws operations) ws "}"
path      ::= "\"" ws "path" ws ":" ws string
operations ::= "\"" ws "operations" ws ":" ws op-array
op-array  ::= "[" ws (operation ("," ws operation)*)? ws "]"

operation ::= "{" ws (op-type "," ws start-line "," ws end-line "," ws content) ws "}"
op-type   ::= "\"" ws "type" ws ":" ws op-kind
op-kind   ::= "\"insert\"" | "\"replace\"" | "\"delete\""
start-line ::= "\"" ws "start_line" ws ":" ws number
end-line  ::= "\"" ws "end_line" ws ":" ws number
content   ::= "\"" ws "content" ws ":" ws string