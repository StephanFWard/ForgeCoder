# Grammar for structured architecture overview output (llama.cpp / llama-server --grammar-file).
# Constrains generation to a structured report of a component's role, files, and risks.
#
# RNP inspiration (PMC10637337): part-whole decomposition of a system into
# its architectural components.

root   ::= object

object ::= "{" ws (overview "," ws files "," ws risks) ws "}"
string ::= "\"" ([^\"\\] | "\\" (["\\/] | "n" | "t" | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
number ::= "-" ? ([0-9] | [1-9] [0-9]*)
ws     ::= [ \t\n]*

overview ::= "\"" ws "overview" ws ":" ws string
files    ::= "\"" ws "key_files" ws ":" ws file_array
risks    ::= "\"" ws "risks" ws ":" ws risk_array

file_array ::= "[" ws (file_obj ("," ws file_obj)*)? ws "]"
file_obj   ::= "{" ws (file_path "," ws file_purpose "," ws file_lines) ws "}"
file_path  ::= "\"" ws "path" ws ":" ws string
file_purpose ::= "\"" ws "purpose" ws ":" ws string
file_lines ::= "\"" ws "lines" ws ":" ws string

risk_array ::= "[" ws (string ("," ws string)*)? ws "]"