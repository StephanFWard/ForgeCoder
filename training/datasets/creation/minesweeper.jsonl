{"instruction": "Make a minesweeper webpage game.", "message": "Created a self-contained minesweeper page (reveal, flag, flood fill, timer, win/lose).", "creates": {"index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Minesweeper</title>\n<style>\n  :root { --cell: 34px; }\n  * { box-sizing: border-box; }\n  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;\n         background: #1c2333; color: #e8ecf4; font-family: \"Segoe UI\", system-ui, sans-serif; }\n  .panel { background: #253048; border-radius: 12px; padding: 18px;\n           box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45); }\n  h1 { margin: 0 0 12px; font-size: 20px; letter-spacing: 2px; text-transform: uppercase; }\n  .hud { display: flex; justify-content: space-between; align-items: center;\n         gap: 12px; margin-bottom: 12px; }\n  .readout { min-width: 64px; text-align: center; background: #131a29; border-radius: 8px;\n             padding: 6px 10px; font-variant-numeric: tabular-nums; font-weight: 600; }\n  .readout small { display: block; font-size: 10px; font-weight: 400; color: #9fb0cc;\n                   text-transform: uppercase; }\n  #restart { border: 0; border-radius: 8px; background: #4a5b80; color: #e8ecf4;\n             padding: 8px 14px; font: 600 13px \"Segoe UI\", system-ui, sans-serif; cursor: pointer; }\n  #restart:hover { background: #5a6d95; }\n  #board { display: grid; grid-template-columns: repeat(10, var(--cell)); gap: 3px; }\n  .cell { width: var(--cell); height: var(--cell); border: 0; border-radius: 6px; cursor: pointer;\n          background: #3b4a68; color: transparent; font: 700 15px/1 \"Segoe UI\", system-ui, sans-serif; }\n  .cell:hover { background: #4a5b80; }\n  .cell.revealed, .cell.revealed:hover { background: #131a29; cursor: default; }\n  .cell.mine { background: #b3261e; color: #fff; }\n  .cell.wrong { background: #7a1f1a; color: #fff; }\n  .cell.flagged { color: #e8ecf4; }\n  .n1 { color: #6ea8fe; } .n2 { color: #7bd88f; } .n3 { color: #ff8fa3; }\n  .n4 { color: #b39ddb; } .n5 { color: #f4a261; } .n6 { color: #4dd0c4; }\n  .n7 { color: #e8ecf4; } .n8 { color: #c9a227; }\n  #status { margin: 12px 0 0; text-align: center; font-weight: 600; min-height: 20px; }\n</style>\n</head>\n<body>\n<main class=\"panel\">\n  <h1>Minesweeper</h1>\n  <div class=\"hud\">\n    <div class=\"readout\"><span id=\"minesLeft\">15</span><small>mines left</small></div>\n    <button id=\"restart\" type=\"button\">New game</button>\n    <div class=\"readout\"><span id=\"timer\">0</span><small>seconds</small></div>\n  </div>\n  <div id=\"board\" role=\"grid\" aria-label=\"Minesweeper board\"></div>\n  <p id=\"status\">Left-click to reveal &middot; Right-click to flag</p>\n<script>\n\"use strict\";\n\nconst ROWS = 10, COLS = 10, MINES = 15;\n\nconst board = document.getElementById(\"board\");\nconst minesLeftEl = document.getElementById(\"minesLeft\");\nconst timerEl = document.getElementById(\"timer\");\nconst statusEl = document.getElementById(\"status\");\nconst restartBtn = document.getElementById(\"restart\");\n\nlet cells = [];\nlet started = false, gameOver = false, timerId = null;\nlet seconds = 0, flagsUsed = 0, revealedCount = 0;\n\nfunction idx(r, c) { return r * COLS + c; }\n\nfunction neighbors(r, c) {\n  const out = [];\n  for (let dr = -1; dr <= 1; dr++) {\n    for (let dc = -1; dc <= 1; dc++) {\n      if (!dr && !dc) continue;\n      const nr = r + dr, nc = c + dc;\n      if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS) out.push(cells[idx(nr, nc)]);\n    }\n  }\n  return out;\n}\n\nfunction buildBoard() {\n  board.innerHTML = \"\";\n  cells = [];\n  for (let r = 0; r < ROWS; r++) {\n    for (let c = 0; c < COLS; c++) {\n      const btn = document.createElement(\"button\");\n      btn.type = \"button\";\n      btn.className = \"cell\";\n      btn.setAttribute(\"role\", \"gridcell\");\n      const cell = { mine: false, revealed: false, flagged: false, el: btn, row: r, col: c };\n      btn.addEventListener(\"click\", () => reveal(cell));\n      btn.addEventListener(\"contextmenu\", (ev) => { ev.preventDefault(); toggleFlag(cell); });\n      cells.push(cell);\n      board.appendChild(btn);\n    }\n  }\n  updateMineCounter();\n}\n\n// First click is always safe: mines are placed after it, avoiding the clicked\n// cell and its neighbors.\nfunction placeMines(safe) {\n  const forbidden = new Set([idx(safe.row, safe.col)]);\n  for (const n of neighbors(safe.row, safe.col)) forbidden.add(idx(n.row, n.col));\n  let placed = 0;\n  while (placed < MINES) {\n    const i = Math.floor(Math.random() * cells.length);\n    if (cells[i].mine || forbidden.has(i)) continue;\n    cells[i].mine = true;\n    placed++;\n  }\n}\n\nfunction startTimer() {\n  seconds = 0;\n  timerEl.textContent = \"0\";\n  timerId = setInterval(() => {\n    seconds++;\n    timerEl.textContent = String(seconds);\n  }, 1000);\n}\n\nfunction stopTimer() {\n  if (timerId) { clearInterval(timerId); timerId = null; }\n}\n\nfunction mineCount(cell) {\n  return neighbors(cell.row, cell.col).filter((n) => n.mine).length;\n}\n\nfunction reveal(cell) {\n  if (gameOver || cell.revealed || cell.flagged) return;\n  if (!started) {\n    started = true;\n    placeMines(cell);\n    startTimer();\n  }\n  if (cell.mine) { lose(cell); return; }\n  floodReveal(cell);\n  checkWin();\n}\n\nfunction floodReveal(cell) {\n  const stack = [cell];\n  while (stack.length) {\n    const cur = stack.pop();\n    if (cur.revealed || cur.flagged || cur.mine) continue;\n    cur.revealed = true;\n    revealedCount++;\n    cur.el.classList.add(\"revealed\");\n    const count = mineCount(cur);\n    if (count) {\n      cur.el.textContent = String(count);\n      cur.el.classList.add(\"n\" + count);\n    } else {\n      for (const n of neighbors(cur.row, cur.col)) {\n        if (!n.revealed) stack.push(n);\n      }\n    }\n  }\n}\n\nfunction toggleFlag(cell) {\n  if (gameOver || cell.revealed) return;\n  cell.flagged = !cell.flagged;\n  cell.el.classList.toggle(\"flagged\", cell.flagged);\n  cell.el.textContent = cell.flagged ? \"\\u{1F6A9}\" : \"\";\n  flagsUsed += cell.flagged ? 1 : -1;\n  updateMineCounter();\n}\n\nfunction updateMineCounter() {\n  minesLeftEl.textContent = String(Math.max(0, MINES - flagsUsed));\n}\n\nfunction lose(hit) {\n  gameOver = true;\n  stopTimer();\n  for (const cell of cells) {\n    if (cell.mine) {\n      cell.el.classList.add(\"mine\");\n      cell.el.textContent = \"\\u{1F4A5}\";\n    } else if (cell.flagged) {\n      cell.el.classList.add(\"wrong\");\n      cell.el.textContent = \"\\u274C\";\n    }\n  }\n  hit.el.classList.add(\"mine\");\n  statusEl.textContent = \"Boom — you hit a mine. Press New game to try again.\";\n}\n\nfunction checkWin() {\n  if (revealedCount < ROWS * COLS - MINES) return;\n  gameOver = true;\n  stopTimer();\n  for (const cell of cells) {\n    if (cell.mine && !cell.flagged) {\n      cell.flagged = true;\n      cell.el.classList.add(\"flagged\");\n      cell.el.textContent = \"\\u{1F6A9}\";\n    }\n  }\n  flagsUsed = MINES;\n  updateMineCounter();\n  statusEl.textContent = \"Cleared in \" + seconds + \"s — well played!\";\n}\n\nrestartBtn.addEventListener(\"click\", () => {\n  stopTimer();\n  started = false;\n  gameOver = false;\n  seconds = 0;\n  flagsUsed = 0;\n  revealedCount = 0;\n  timerEl.textContent = \"0\";\n  statusEl.textContent = \"Left-click to reveal \\u00B7 Right-click to flag\";\n  buildBoard();\n});\n\nbuildBoard();\n</script>\n</body>\n</html>\n"}, "language": "html"}
