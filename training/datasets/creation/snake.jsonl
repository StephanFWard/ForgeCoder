{"instruction": "Make the game snake in html.", "message": "Created a self-contained snake page (canvas, arrow/WASD controls, food, score, speed-up, pause, game over).", "creates": {"index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Snake</title>\n<style>\n  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;\n         background: #101820; color: #e8f0f8; font-family: \"Segoe UI\", system-ui, sans-serif; }\n  .panel { background: #1b2735; border-radius: 12px; padding: 18px;\n           box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); }\n  h1 { margin: 0 0 10px; font-size: 20px; letter-spacing: 2px; text-transform: uppercase; }\n  .hud { display: flex; justify-content: space-between; margin-bottom: 10px;\n         font-variant-numeric: tabular-nums; }\n  .hud b { font-weight: 700; }\n  canvas { display: block; background: #0b1219; border-radius: 8px; }\n  #status { margin: 10px 0 0; text-align: center; min-height: 20px; font-weight: 600; }\n  #restart { border: 0; border-radius: 8px; background: #2f4159; color: #e8f0f8;\n             padding: 8px 14px; margin-top: 10px; width: 100%; cursor: pointer;\n             font: 600 13px \"Segoe UI\", system-ui, sans-serif; }\n  #restart:hover { background: #3c5370; }\n</style>\n</head>\n<body>\n<main class=\"panel\">\n  <h1>Snake</h1>\n  <div class=\"hud\">\n    <div>Score <b id=\"score\">0</b></div>\n    <div>Best <b id=\"best\">0</b></div>\n  </div>\n  <canvas id=\"board\" width=\"400\" height=\"400\" aria-label=\"Snake board\"></canvas>\n  <p id=\"status\">Arrow keys or WASD to steer &middot; P to pause</p>\n  <button id=\"restart\" type=\"button\">New game</button>\n<script>\n\"use strict\";\n\nconst CELLS = 20, CELL = 20, SPEED_START = 140, SPEED_MIN = 60;\n\nconst canvas = document.getElementById(\"board\");\nconst ctx = canvas.getContext(\"2d\");\nconst scoreEl = document.getElementById(\"score\");\nconst bestEl = document.getElementById(\"best\");\nconst statusEl = document.getElementById(\"status\");\nconst restartBtn = document.getElementById(\"restart\");\n\nlet snake, direction, nextDirection, food;\nlet score = 0, best = 0, speed = SPEED_START;\nlet timerId = null, paused = false, gameOver = false;\n\nfunction reset() {\n  snake = [{ x: 10, y: 10 }, { x: 9, y: 10 }, { x: 8, y: 10 }];\n  direction = { x: 1, y: 0 };\n  nextDirection = direction;\n  score = 0;\n  speed = SPEED_START;\n  paused = false;\n  gameOver = false;\n  food = spawnFood();\n  scoreEl.textContent = \"0\";\n  statusEl.textContent = \"Arrow keys or WASD to steer \\u00B7 P to pause\";\n  schedule();\n  draw();\n}\n\nfunction spawnFood() {\n  for (;;) {\n    const f = {\n      x: Math.floor(Math.random() * CELLS),\n      y: Math.floor(Math.random() * CELLS),\n    };\n    if (!snake.some((s) => s.x === f.x && s.y === f.y)) return f;\n  }\n}\n\nfunction schedule() {\n  if (timerId) clearInterval(timerId);\n  timerId = setInterval(tick, speed);\n}\n\nfunction tick() {\n  if (paused || gameOver) return;\n  direction = nextDirection;\n  const head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };\n  const hitWall = head.x < 0 || head.y < 0 || head.x >= CELLS || head.y >= CELLS;\n  const hitSelf = snake.some((s) => s.x === head.x && s.y === head.y);\n  if (hitWall || hitSelf) { endGame(); return; }\n  snake.unshift(head);\n  if (head.x === food.x && head.y === food.y) {\n    score++;\n    scoreEl.textContent = String(score);\n    if (score > best) { best = score; bestEl.textContent = String(best); }\n    speed = Math.max(SPEED_MIN, speed - 6);\n    schedule();\n    food = spawnFood();\n  } else {\n    snake.pop();\n  }\n  draw();\n}\n\nfunction endGame() {\n  gameOver = true;\n  if (timerId) { clearInterval(timerId); timerId = null; }\n  statusEl.textContent = \"Game over — score \" + score + \". Press New game.\";\n  draw();\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = \"#e2543e\";\n  ctx.beginPath();\n  ctx.arc(food.x * CELL + CELL / 2, food.y * CELL + CELL / 2, CELL / 2 - 3, 0, Math.PI * 2);\n  ctx.fill();\n  for (let i = 0; i < snake.length; i++) {\n    ctx.fillStyle = i === 0 ? \"#7bd88f\" : \"#5aa86f\";\n    ctx.fillRect(snake[i].x * CELL + 1, snake[i].y * CELL + 1, CELL - 2, CELL - 2);\n  }\n  if (gameOver) {\n    ctx.fillStyle = \"rgba(16, 24, 32, 0.6)\";\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n    ctx.fillStyle = \"#e8f0f8\";\n    ctx.font = \"700 28px 'Segoe UI', system-ui, sans-serif\";\n    ctx.textAlign = \"center\";\n    ctx.fillText(\"Game over\", canvas.width / 2, canvas.height / 2);\n  }\n}\n\nconst KEY_DIRS = {\n  ArrowUp: { x: 0, y: -1 }, KeyW: { x: 0, y: -1 },\n  ArrowDown: { x: 0, y: 1 }, KeyS: { x: 0, y: 1 },\n  ArrowLeft: { x: -1, y: 0 }, KeyA: { x: -1, y: 0 },\n  ArrowRight: { x: 1, y: 0 }, KeyD: { x: 1, y: 0 },\n};\n\ndocument.addEventListener(\"keydown\", (ev) => {\n  if (ev.code === \"KeyP\") { paused = !paused; return; }\n  const dir = KEY_DIRS[ev.code];\n  if (!dir) return;\n  ev.preventDefault();\n  // No 180-degree turns: the new direction cannot reverse into the neck.\n  if (dir.x !== -direction.x || dir.y !== -direction.y) nextDirection = dir;\n});\n\nrestartBtn.addEventListener(\"click\", reset);\nreset();\n</script>\n</body>\n</html>\n"}, "language": "html"}
{"instruction": "Create the classic snake game as a single HTML page I can open in the browser.", "message": "Created a self-contained snake page (canvas, arrow/WASD controls, food, score, speed-up, pause, game over).", "creates": {"index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Snake</title>\n<style>\n  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;\n         background: #101820; color: #e8f0f8; font-family: \"Segoe UI\", system-ui, sans-serif; }\n  .panel { background: #1b2735; border-radius: 12px; padding: 18px;\n           box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); }\n  h1 { margin: 0 0 10px; font-size: 20px; letter-spacing: 2px; text-transform: uppercase; }\n  .hud { display: flex; justify-content: space-between; margin-bottom: 10px;\n         font-variant-numeric: tabular-nums; }\n  .hud b { font-weight: 700; }\n  canvas { display: block; background: #0b1219; border-radius: 8px; }\n  #status { margin: 10px 0 0; text-align: center; min-height: 20px; font-weight: 600; }\n  #restart { border: 0; border-radius: 8px; background: #2f4159; color: #e8f0f8;\n             padding: 8px 14px; margin-top: 10px; width: 100%; cursor: pointer;\n             font: 600 13px \"Segoe UI\", system-ui, sans-serif; }\n  #restart:hover { background: #3c5370; }\n</style>\n</head>\n<body>\n<main class=\"panel\">\n  <h1>Snake</h1>\n  <div class=\"hud\">\n    <div>Score <b id=\"score\">0</b></div>\n    <div>Best <b id=\"best\">0</b></div>\n  </div>\n  <canvas id=\"board\" width=\"400\" height=\"400\" aria-label=\"Snake board\"></canvas>\n  <p id=\"status\">Arrow keys or WASD to steer &middot; P to pause</p>\n  <button id=\"restart\" type=\"button\">New game</button>\n<script>\n\"use strict\";\n\nconst CELLS = 20, CELL = 20, SPEED_START = 140, SPEED_MIN = 60;\n\nconst canvas = document.getElementById(\"board\");\nconst ctx = canvas.getContext(\"2d\");\nconst scoreEl = document.getElementById(\"score\");\nconst bestEl = document.getElementById(\"best\");\nconst statusEl = document.getElementById(\"status\");\nconst restartBtn = document.getElementById(\"restart\");\n\nlet snake, direction, nextDirection, food;\nlet score = 0, best = 0, speed = SPEED_START;\nlet timerId = null, paused = false, gameOver = false;\n\nfunction reset() {\n  snake = [{ x: 10, y: 10 }, { x: 9, y: 10 }, { x: 8, y: 10 }];\n  direction = { x: 1, y: 0 };\n  nextDirection = direction;\n  score = 0;\n  speed = SPEED_START;\n  paused = false;\n  gameOver = false;\n  food = spawnFood();\n  scoreEl.textContent = \"0\";\n  statusEl.textContent = \"Arrow keys or WASD to steer \\u00B7 P to pause\";\n  schedule();\n  draw();\n}\n\nfunction spawnFood() {\n  for (;;) {\n    const f = {\n      x: Math.floor(Math.random() * CELLS),\n      y: Math.floor(Math.random() * CELLS),\n    };\n    if (!snake.some((s) => s.x === f.x && s.y === f.y)) return f;\n  }\n}\n\nfunction schedule() {\n  if (timerId) clearInterval(timerId);\n  timerId = setInterval(tick, speed);\n}\n\nfunction tick() {\n  if (paused || gameOver) return;\n  direction = nextDirection;\n  const head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };\n  const hitWall = head.x < 0 || head.y < 0 || head.x >= CELLS || head.y >= CELLS;\n  const hitSelf = snake.some((s) => s.x === head.x && s.y === head.y);\n  if (hitWall || hitSelf) { endGame(); return; }\n  snake.unshift(head);\n  if (head.x === food.x && head.y === food.y) {\n    score++;\n    scoreEl.textContent = String(score);\n    if (score > best) { best = score; bestEl.textContent = String(best); }\n    speed = Math.max(SPEED_MIN, speed - 6);\n    schedule();\n    food = spawnFood();\n  } else {\n    snake.pop();\n  }\n  draw();\n}\n\nfunction endGame() {\n  gameOver = true;\n  if (timerId) { clearInterval(timerId); timerId = null; }\n  statusEl.textContent = \"Game over — score \" + score + \". Press New game.\";\n  draw();\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = \"#e2543e\";\n  ctx.beginPath();\n  ctx.arc(food.x * CELL + CELL / 2, food.y * CELL + CELL / 2, CELL / 2 - 3, 0, Math.PI * 2);\n  ctx.fill();\n  for (let i = 0; i < snake.length; i++) {\n    ctx.fillStyle = i === 0 ? \"#7bd88f\" : \"#5aa86f\";\n    ctx.fillRect(snake[i].x * CELL + 1, snake[i].y * CELL + 1, CELL - 2, CELL - 2);\n  }\n  if (gameOver) {\n    ctx.fillStyle = \"rgba(16, 24, 32, 0.6)\";\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n    ctx.fillStyle = \"#e8f0f8\";\n    ctx.font = \"700 28px 'Segoe UI', system-ui, sans-serif\";\n    ctx.textAlign = \"center\";\n    ctx.fillText(\"Game over\", canvas.width / 2, canvas.height / 2);\n  }\n}\n\nconst KEY_DIRS = {\n  ArrowUp: { x: 0, y: -1 }, KeyW: { x: 0, y: -1 },\n  ArrowDown: { x: 0, y: 1 }, KeyS: { x: 0, y: 1 },\n  ArrowLeft: { x: -1, y: 0 }, KeyA: { x: -1, y: 0 },\n  ArrowRight: { x: 1, y: 0 }, KeyD: { x: 1, y: 0 },\n};\n\ndocument.addEventListener(\"keydown\", (ev) => {\n  if (ev.code === \"KeyP\") { paused = !paused; return; }\n  const dir = KEY_DIRS[ev.code];\n  if (!dir) return;\n  ev.preventDefault();\n  // No 180-degree turns: the new direction cannot reverse into the neck.\n  if (dir.x !== -direction.x || dir.y !== -direction.y) nextDirection = dir;\n});\n\nrestartBtn.addEventListener(\"click\", reset);\nreset();\n</script>\n</body>\n</html>\n"}, "language": "html"}
