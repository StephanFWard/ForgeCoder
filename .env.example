# Copy to `.env.local` (gitignored) and fill in real values.
# The optional, BILLED, opt-in-only Jev backend (`backend="jev"`) additionally
# requires FORGECODER_SYSTEM_ONE_ALLOW_PAID=1 at call time — a key alone never
# turns billing on.

# Hosted Jev API key. Prefix decides the endpoint automatically:
#   jv_live_...  -> jevtypesafeai.com wrapper (model optional)
#   anything else -> official TypeSafe API (model required, sent by default)
JEV_API_KEY=

# Optional overrides (defaults are chosen from the key prefix):
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

